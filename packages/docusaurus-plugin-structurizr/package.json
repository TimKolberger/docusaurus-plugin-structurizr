{
  "name": "docusaurus-plugin-structurizr",
  "version": "0.6.0",
  "description": "This plugin allows you to use structurizr diagrams in your docusaurus documentation.",
  "keywords": [
    "diagrams",
    "documentation",
    "docusaurus",
    "docusaurus-plugin",
    "mermaid",
    "plantuml",
    "structurizr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TimKolberger/docusaurus-plugin-structurizr.git",
    "directory": "packages/docusaurus-plugin-structurizr"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "pnpm \"/lint:/\"",
    "lint:oxlint": "oxlint",
    "lint:format": "oxfmt --check",
    "lint:types": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest --run --coverage"
  },
  "dependencies": {
    "globby": "^11.1.0"
  },
  "devDependencies": {
    "@docusaurus/types": "3.10.2",
    "@docusaurus/utils-validation": "3.10.2",
    "@dps/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@docusaurus/utils-validation": ">3.0.1"
  }
}
